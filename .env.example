# CareLoop — Environment Variables Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file — it's already excluded in .gitignore.

# ── LLM API ──────────────────────────────────────────────
# Used for both the Extractor and Generator LLM calls (see GEMINI.md).
# Pick whichever provider you're using and fill in that key only.

ANTHROPIC_API_KEY=your_anthropic_key_here
# or
GEMINI_API_KEY=your_gemini_key_here

# ── OCR (only needed if not using a vision-capable LLM directly) ──
GOOGLE_VISION_API_KEY=your_google_vision_key_here

# ── Database ─────────────────────────────────────────────
# SQLite: just a local file path, no real secret needed.
DATABASE_URL=sqlite:///./careloop.db

# If using Firebase/Firestore instead, uncomment and fill in:
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_PRIVATE_KEY=your_private_key
# FIREBASE_CLIENT_EMAIL=your_client_email

# ── Backend config ───────────────────────────────────────
PORT=8000
ENVIRONMENT=development
# Optional comma-separated CORS allowlist for deployed frontends
# CORS_ORIGINS=https://your-frontend.example.com,http://localhost:5173

# ── Frontend config (if your frontend build needs the API URL) ──
VITE_API_BASE_URL=http://localhost:8000
